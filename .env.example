# Django
DJANGO_ENV=local
SECRET_KEY=change-me-to-a-random-string-at-least-50-chars-long-abc123
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://belong:belong@postgres:5432/belong

# Redis
REDIS_URL=redis://redis:6379/0
# Django cache — backs request throttling. Must be shared across workers.
CACHE_URL=redis://redis:6379/3

# JWT
JWT_SIGNING_KEY=change-me-to-a-separate-random-string-at-least-50-chars

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Object storage — Cloudflare R2 (S3-compatible API)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_URL=

# Private bucket: KYC documents and selfies. Never public — reachable only
# through short-lived signed URLs.
AWS_BUCKET=belong-bucket

# Public bucket: fund and playlist heroes, holding logos, profile photos.
# Routed by key prefix (see PUBLIC_FOLDERS in apps/common/services/
# media_routing.py). Served under permanent, cacheable URLs.
PUBLIC_MEDIA_BUCKET=belong-media
# Cloudflare custom domain attached to the public bucket.
PUBLIC_MEDIA_URL=https://media.belong.club
