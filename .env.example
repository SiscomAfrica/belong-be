# Django
DJANGO_ENV=local
SECRET_KEY=change-me-to-a-random-string-at-least-50-chars-long-abc123
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://belong:belong@postgres:5432/belong

# Redis
REDIS_URL=redis://redis:6379/0
# Django cache — backs request throttling. Must be shared across workers.
CACHE_URL=redis://redis:6379/3

# JWT
JWT_SIGNING_KEY=change-me-to-a-separate-random-string-at-least-50-chars

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Object storage — Cloudflare R2 (S3-compatible API)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_URL=

# Private bucket: KYC documents and selfies. Never public — reachable only
# through short-lived signed URLs.
AWS_BUCKET=belong-bucket

# Public bucket: fund and playlist heroes, holding logos, profile photos.
# Routed by key prefix (see PUBLIC_FOLDERS in apps/common/services/
# media_routing.py). Served under permanent, cacheable URLs.
PUBLIC_MEDIA_BUCKET=belong-media
# Cloudflare custom domain attached to the public bucket.
PUBLIC_MEDIA_URL=https://media.belong.club

# M-Pesa (Daraja) — STK push and Ratiba share these credentials.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
# sandbox | production
MPESA_ENV=sandbox
# Public origin Safaricom posts callbacks back to. Must be HTTPS and reachable
# from the internet — Daraja will not call a localhost or self-signed host.
MPESA_CALLBACK_BASE_URL=https://api.belong.club

# M-Pesa Ratiba (standing orders) — automated recurring deductions.
# Leave false until the commercial agreement with Safaricom is signed: Ratiba
# needs one on top of the usual shortcode approval. While off, recurring plans
# still invest, but only from wallet balance the user tops up themselves.
MPESA_RATIBA_ENABLED=false
# Paybill collecting the deductions. Falls back to MPESA_SHORTCODE when blank.
MPESA_RATIBA_SHORTCODE=
# "4" = PayBill, "2" = Till.
MPESA_RATIBA_RECEIVER_TYPE=4
# Ratiba requires an explicit EndDate; this is how far ahead one is written.
MPESA_RATIBA_DURATION_DAYS=730

# Ratiba executions are NOT reported on the Ratiba callback URL — that only
# reports whether the standing order was created. Each execution pays the
# paybill as ordinary C2B, quoting the AccountReference we generated. Register
# the confirmation URL once per shortcode before going live:
#
#   python manage.py register_c2b_urls
#
# Until that is done, deductions land on the paybill unseen and no plan is
# ever funded.

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
